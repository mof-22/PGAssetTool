<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PGAssetTool.Gui.ViewModels"
        x:Class="PGAssetTool.Gui.Views.OptionsWindow"
        x:DataType="vm:MainViewModel"
        Title="Options" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">

  <StackPanel Margin="20" Spacing="16">

    <StackPanel Spacing="6">
      <TextBlock Text="The game" FontWeight="SemiBold" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Choose…" Click="OnChooseGame" Margin="6,0,0,0" />
        <TextBox Text="{Binding GameDirectory}" Watermark="Left blank to find it through Steam" />
      </DockPanel>
      <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                 Text="The folder holding the game's own *_Data directory. Only Steam can be asked where it put the game, so an installation from anywhere else is named here — as is a copy of the game data, which is the safe way to work on this without touching what you play. Changing it opens that installation instead." />
      <TextBlock Text="{Binding GameDescribed}" Opacity="0.55" FontSize="11"
                 FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Weapon names" FontWeight="SemiBold" />
      <ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding Language}"
                SelectedValueBinding="{Binding Bundle}" HorizontalAlignment="Stretch" />
      <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                 Text="Which of the translation tables shipped with the game names are read from. Changing it reads the game again." />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Author" FontWeight="SemiBold" />
      <TextBox Text="{Binding Author}" Watermark="Left blank if you would rather not be named" />
      <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                 Text="Recorded in the manifest of everything extracted from here on, and shown to whoever installs the pack. It can be changed per pack in the editor." />
    </StackPanel>

    <StackPanel Spacing="6">
      <CheckBox Content="Write textures without an alpha channel" IsChecked="{Binding OpaqueTextures}" />
      <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                 Text="Most weapon textures keep emission rather than transparency in that channel, so an image editor opens them almost invisible. An image brought back without an alpha channel is given the original one, so nothing is lost by turning this on." />
    </StackPanel>

    <StackPanel Spacing="6">
      <CheckBox Content="Protect new packs" IsChecked="{Binding ProtectPacks}" />
      <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                 Text="Signs a built pack with a key kept beside this tool, and keeps it from opening as a zip. Anyone who alters one afterwards shows up as having done so. It stops a casual look inside and nothing more — this tool's own source says how the scrambling works — and each pack can override this in the editor." />
      <TextBlock Text="{Binding AuthorFingerprint}" Opacity="0.55" FontSize="11"
                 FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="6">
      <CheckBox Content="Rebuild bundles for speed rather than size" IsChecked="{Binding FasterApplies}" />
      <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                 Text="Every install, and every mod turned on or off, rebuilds the bundles those mods touch. Squeezing them less makes that part about four times quicker and the bundles about a sixth larger — thirty megabytes across a game with thirty mods on it — which comes to about a tenth off a whole apply here, and more on a machine with fewer cores to spread the work across. The game loads both at the same speed. Turning this back off does not undo it: the next change writes the bundles small again." />
    </StackPanel>

    <StackPanel Spacing="6">
      <CheckBox Content="Show only what can be replaced" IsChecked="{Binding ReplaceableOnly}" />
      <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                 Text="Hides the transforms, scripts and animation an asset tree is mostly made of. What counts as replaceable follows what the tool can actually write back." />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Opacity="0.55" FontSize="11" Text="Settings are kept beside the executable:" />
      <TextBlock Opacity="0.55" FontSize="11" FontFamily="Consolas, Menlo, monospace"
                 Text="{Binding SettingsPath}" TextWrapping="Wrap" />
    </StackPanel>

    <Button Content="Close" Click="OnClose" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
